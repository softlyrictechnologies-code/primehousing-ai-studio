rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function roleRank() {
      let signedIn = request.auth != null;
      let uid = signedIn ? request.auth.uid : '__none__';
      let adminPath = /databases/(default)/documents/admins/$(uid);
      let hasDoc = signedIn && firestore.exists(adminPath);
      let docData = hasDoc ? firestore.get(adminPath).data : {};
      let docActive = !hasDoc || docData.get('active', true) != false;
      let rawDocRole = hasDoc ? docData.get('role', '') : '';
      let docRole = rawDocRole is string ? rawDocRole.lower() : '';
      let docRank = !hasDoc ? 0 : (
        docRole in ['super_admin', 'super-admin'] ? 4 :
        (docRole == '' || docRole == 'admin') ? 3 :
        docRole == 'editor' ? 2 :
        docRole == 'support' ? 1 : 0
      );
      let rawClaimRole = signedIn ? request.auth.token.get('role', '') : '';
      let claimRole = rawClaimRole is string ? rawClaimRole.lower() : '';
      let claimRank = !signedIn ? 0 : (
        (request.auth.token.get('superAdmin', false) == true || claimRole in ['super_admin', 'super-admin']) ? 4 :
        (request.auth.token.get('admin', false) == true || claimRole == 'admin') ? 3 :
        claimRole == 'editor' ? 2 :
        claimRole == 'support' ? 1 : 0
      );
      return (!signedIn || !docActive) ? 0 : (claimRank > docRank ? claimRank : docRank);
    }

    function isAdminOrSuperAdmin() {
      return roleRank() >= 3;
    }

    function isEditorOrAbove() {
      return roleRank() >= 2;
    }

    function isStaff() {
      return roleRank() >= 1;
    }

    function isValidImage() {
      return request.resource != null
        && request.resource.contentType is string
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function isValidPdf() {
      return request.resource != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024;
    }

    // Optional static brand logo reference
    match /logo.png {
      allow read: if true;
      allow write: if false;
    }

    // Property images & fallback project assets (public read; editor/admin write & delete)
    match /properties/{propertyId}/{fileName} {
      allow read: if true;
      allow create, update: if isEditorOrAbove()
        && (isValidImage() || (propertyId.matches('^project_.*') && isValidPdf()));
      allow delete: if isEditorOrAbove();
    }

    // Project images & PDF documents (public read; editor/admin write & delete)
    match /projects/{projectId}/{folderCategory}/{fileName} {
      allow read: if true;
      allow create, update: if isEditorOrAbove()
        && (isValidImage() || isValidPdf());
      allow delete: if isEditorOrAbove();
    }

    // Landowner submission images (public valid-image create; staff read/update; admin/super_admin delete)
    match /sellerSubmissions/{submissionId}/{fileName} {
      allow read: if isStaff();
      allow create: if isValidImage();
      allow update: if isStaff() && isValidImage();
      allow delete: if isAdminOrSuperAdmin();
    }

    // Deny all unsupported paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
