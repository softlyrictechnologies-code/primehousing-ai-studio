rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function normalizeRole(raw) {
      return raw is string ? raw.lower() : '';
    }

    function rankOfRole(role) {
      return role in ['super_admin', 'super-admin'] ? 4 :
        role == 'admin' ? 3 :
        role == 'editor' ? 2 :
        role == 'support' ? 1 : 0;
    }

    function claimRank() {
      let signedIn = request.auth != null;
      let role = signedIn ? normalizeRole(request.auth.token.get('role', '')) : '';
      return !signedIn ? 0 : (
        (request.auth.token.get('superAdmin', false) == true || role in ['super_admin', 'super-admin']) ? 4 :
        (request.auth.token.get('admin', false) == true || role == 'admin') ? 3 :
        rankOfRole(role)
      );
    }

    function docRank() {
      let uid = request.auth != null ? request.auth.uid : '__none__';
      let path = /databases/(default)/documents/admins/$(uid);
      let hasDoc = request.auth != null && firestore.exists(path);
      let rawRole = hasDoc ? firestore.get(path).data.get('role', '') : '';
      let role = normalizeRole(rawRole);
      return !hasDoc ? 0 : (role == '' ? 3 : rankOfRole(role));
    }

    function isAdminDocInactive(uid) {
      let path = /databases/(default)/documents/admins/$(uid);
      return firestore.exists(path) && firestore.get(path).data.get('active', true) == false;
    }

    function roleRank() {
      let signedIn = request.auth != null;
      let uid = signedIn ? request.auth.uid : '__none__';
      let inactive = signedIn && isAdminDocInactive(uid);
      let cRank = signedIn && !inactive ? claimRank() : 0;
      let dRank = signedIn && !inactive ? docRank() : 0;
      return cRank > dRank ? cRank : dRank;
    }

    function isAdminOrSuperAdmin() {
      return roleRank() >= 3;
    }

    function isEditorOrAbove() {
      return roleRank() >= 2;
    }

    function isStaff() {
      return roleRank() >= 1;
    }

    function isValidImage() {
      return request.resource != null
        && request.resource.contentType is string
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function isValidPdf() {
      return request.resource != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024;
    }

    // Optional static brand logo reference
    match /logo.png {
      allow read: if true;
      allow write: if false;
    }

    // Property images & fallback project assets (public read; editor/admin write & delete)
    match /properties/{propertyId}/{fileName} {
      allow read: if true;
      allow create, update: if isEditorOrAbove()
        && (isValidImage() || (propertyId.matches('^project_.*') && isValidPdf()));
      allow delete: if isEditorOrAbove();
    }

    // Project images & PDF documents (public read; editor/admin write & delete)
    match /projects/{projectId}/{folderCategory}/{fileName} {
      allow read: if true;
      allow create, update: if isEditorOrAbove()
        && (isValidImage() || isValidPdf());
      allow delete: if isEditorOrAbove();
    }

    // Landowner submission images (public valid-image create; staff read/update; admin/super_admin delete)
    match /sellerSubmissions/{submissionId}/{fileName} {
      allow read: if isStaff();
      allow create: if isValidImage();
      allow update: if isStaff() && isValidImage();
      allow delete: if isAdminOrSuperAdmin();
    }

    // Deny all unsupported paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
